{
  "name": "chrome-vue3-extension",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,html,css}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,html,css}\" \"*.{js,ts,json}\""
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.93.3",
    "typescript": "^5.3.0",
    "vite": "^5.2.11"
  }
}
